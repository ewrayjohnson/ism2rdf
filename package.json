{
  "name": "ism2rdf",
  "version": "1.0.0",
  "description": "Transforms Intelligence Community XSD schemas into RDF/OWL/SHACL representations with JSON-LD, Turtle, and N-Triples output.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ism2rdf": "./dist/index.js"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "npm run build && node dist/index.js && node --test",
    "prepack": "npm run build",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "keywords": [
    "ISM.XML",
    "EDH.XML",
    "Security Markings",
    "Intelligence Community",
    "RDF",
    "XSD",
    "OWL",
    "SHACL",
    "SKOS",
    "IC-CIO",
    "JSON-LD",
    "Turtle",
    "ontology",
    "semantic-web"
  ],
  "author": "E. W. Johnson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ewrayjohnson/ism2rdf.git"
  },
  "bugs": {
    "url": "https://github.com/ewrayjohnson/ism2rdf/issues"
  },
  "homepage": "https://github.com/ewrayjohnson/ism2rdf#readme",
  "dependencies": {
    "@entryscape/rdfjson": "^2.7.7",
    "@jeswr/pretty-turtle": "^1.6.2",
    "@rdfjs/data-model": "^2.1.0",
    "jsonld": "^9.0.0",
    "lodash": "^4.17.21",
    "rdf-quad": "^2.0.0",
    "xml2js": "^0.6.2",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.16",
    "@types/rdfjs__data-model": "^2.0.9",
    "@types/jsonld": "^1.5.15",
    "@types/node": "^18.19.0",
    "@rdfjs/types": "^2.0.1",
    "@typescript-eslint/parser": "~8.46.0",
    "@types/xml2js": "^0.4.14",
    "eslint": "^8.56.0",
    "n3": "^1.25.2",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
